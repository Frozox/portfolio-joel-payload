DATABASE_URL=postgres://postgres:portfolio-joel-payload@127.0.0.1:5432/portfolio-joel-payload
PAYLOAD_SECRET=YOUR_SECRET_HERE
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# --- MONITORING ENV (Sentry) ---
# DSN is public and can be exposed to the browser
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
# Used at build time to upload source maps, keep it secret
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
SENTRY_ORG=YOUR_SENTRY_ORG_SLUG
SENTRY_PROJECT=YOUR_SENTRY_PROJECT_SLUG

# --- FRONTEND ENV ---
NEXT_PUBLIC_FRONTEND_HOST=http://localhost:3000
NEXT_PUBLIC_HCAPTCHA_SITEKEY=YOUR_HCAPTCHA_SITEKEY
HCAPTCHA_SECRET=YOUR_HCAPTCHA_SECRET
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID
